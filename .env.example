# Copy to .env for local development. Never commit real secrets.
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-another-long-random-password
GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
ASGV_SECRET_BACKEND=env
AWS_REGION=ap-south-1
# For AWS Secrets Manager: set ASGV_SECRET_BACKEND=aws and grant the container
# an IAM role with secretsmanager:GetSecretValue for the required secret ARNs.
# DATABASE_URL_SECRET_ID=prod/asgv/database-url
# GITHUB_WEBHOOK_SECRET_SECRET_ID=prod/asgv/github-webhook-secret
